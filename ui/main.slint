                            text <=> root.dark-at;
                            placeholder-text: "19:00";
                            width: 90px;
                            accepted => { root.settings-changed(); } edited(_t) => { root.settings-changed(); }
                        }
                    }
                }

                if root.mode-index == 1 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        LineEdit {
                            text <=> root.lat;
                            placeholder-text: root.t-lat-ph;
                            horizontal-stretch: 1;
