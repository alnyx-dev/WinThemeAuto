                        placeholder-text: "0078D4";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); } edited(_t) => { root.settings-changed(); }
                    }
                    AccentSwatch { swatch-color: #FFB900; hex: "FFB900"; active: root.dark-accent == "FFB900"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #E81123; hex: "E81123"; active: root.dark-accent == "E81123"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #EC008C; hex: "EC008C"; active: root.dark-accent == "EC008C"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #B4009E; hex: "B4009E"; active: root.dark-accent == "B4009E"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #744DA9; hex: "744DA9"; active: root.dark-accent == "744DA9"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #0078D4; hex: "0078D4"; active: root.dark-accent == "0078D4"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #00B7C3; hex: "00B7C3"; active: root.dark-accent == "00B7C3"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #107C10; hex: "107C10"; active: root.dark-accent == "107C10"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                }
                Text {
                    text: root.t-accent-hint;
                    font-size: 10px;
                    color: #94a3b8;
                    overflow: elide;
                }
            }
        }

        if root.tab-index == 2 : VerticalBox {
            padding: 0px;
            spacing: 8px;
            Rectangle {
                background: white;
                border-width: 1px;
                border-color: #e2e8f0;
                border-radius: 10px;
                VerticalBox {
                    padding: 10px;
                    spacing: 8px;
                    CheckBox {
                        text: root.t-autostart;
                        checked <=> root.autostart;
                        toggled => { root.autostart-changed(); }
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text {
                            text: root.t-language;
                            font-size: 13px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "EN";
                            primary: root.lang-index == 0;
                            clicked => {
                                root.lang-index = 0;
                                root.language-changed();
                            }
                        }
                        Button {
                            text: "RU";
                            primary: root.lang-index == 1;
                            clicked => {
                                root.lang-index = 1;
                                root.language-changed();
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: white;
                border-width: 1px;
                border-color: #e2e8f0;
                border-radius: 10px;
                VerticalBox {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Button {
                            text: root.checking-update ? root.t-checking : root.t-check-updates;
                            enabled: !root.checking-update;
                            clicked => { root.check-updates(); }
                        }
                        Text {
                            text: root.update-info != "" ? root.update-info : "v" + root.app-version;
                            font-size: 11px;
                            color: root.update-ok ? #15803d : #94a3b8;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if !root.checking-update : Button {
                            text: root.t-releases;
                            clicked => { root.open-releases(); }
                        }
                        if root.checking-update : Button {
                            text: root.t-cancel;
                            clicked => { root.cancel-update(); }
                        }
                    }
                }
            }
            }
        }
        }

        if root.status != "" : Text {
            text: root.status;
            font-size: 11px;
            font-weight: 600;
            color: #b91c1c;
            wrap: word-wrap;
        }
        Button {
            text: root.dirty ? root.t-apply + " вЂў" : root.t-apply;
            primary: true;
            horizontal-stretch: 1;
            clicked => { root.apply-settings(); }
        }
    }

    if root.show-close-dialog : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea {
            width: parent.width;
            height: parent.height;
        }
        VerticalBox {
            padding: 48px;
            alignment: center;
            HorizontalBox {
                padding: 0px;
                alignment: center;
                Rectangle {
                    width: 330px;
                    background: white;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    border-radius: 12px;
                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;
                        Text {
                            text: root.t-close-title;
                            font-size: 14px;
                            font-weight: 700;
                            color: #0f172a;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.t-close-body;
                            font-size: 12px;
                            color: #64748b;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: root.t-close-never;
                            checked <=> root.close-never-ask;
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Button {
                                text: root.t-close-minimize;
                                primary: true;
                                horizontal-stretch: 1;
                                clicked => { root.close-minimize(); }
                            }
                            Button {
                                text: root.t-close-quit;
                                horizontal-stretch: 1;
                                clicked => { root.close-quit(); }
                            }
