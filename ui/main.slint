import { Switch, CheckBox, LineEdit, Button, ComboBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

component AccentSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <string> hex;
    in property <bool> active;
    callback chosen(string);

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: swatch-color;
    border-width: (active || fs.has-focus) ? 2px : 1px;
    border-color: fs.has-focus ? #2563eb : (active ? #0f172a : #00000033);

    fs := FocusScope {
        accessible-role: button;
        accessible-label: "accent color " + root.hex;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.chosen(root.hex);
                accept
            } else {
                reject
            }
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { fs.focus(); root.chosen(root.hex); }
    }
}

export component MainWindow inherits Window {
    title: "WinThemeAuto";
    icon: @image-url("../icon.svg");
    background: #eef1f6;
    preferred-width: 500px;
    min-width: 480px;

    in property <bool> is-dark;
    in property <string> status;
    in property <string> sun-info;
    in property <string> next-switch;
    in property <string> geo-hint;
    in property <bool> locating;

    in-out property <bool> auto-enabled;
    in-out property <int> mode-index;
    in-out property <string> light-at;
    in-out property <string> dark-at;
    in-out property <string> lat;
    in-out property <string> lon;
    in-out property <string> light-offset;
    in-out property <string> dark-offset;
    in-out property <bool> change-apps;
    in-out property <bool> change-system;
    in-out property <bool> autostart;
    in-out property <bool> show-advanced;
    in property <string> app-version;
    in property <string> update-info;
    in property <bool> update-ok;
    in property <bool> checking-update;
    in property <[string]> light-themes;
    in-out property <int> light-theme-index;
    in property <[string]> dark-themes;
    in-out property <int> dark-theme-index;
    in-out property <string> light-wallpaper;
    in-out property <string> dark-wallpaper;
    in-out property <bool> accent-enabled;
    in-out property <string> light-accent;
    in-out property <string> dark-accent;
    in-out property <int> lang-index;
    in property <bool> dirty;
    in property <bool> show-close-dialog;
    in-out property <bool> close-never-ask;
    in property <image> light-wp-preview;
    in property <bool> light-wp-has;
    in property <image> dark-wp-preview;
    in property <bool> dark-wp-has;

    in property <string> t-tab-auto;
    in property <string> t-tab-appearance;
    in property <string> t-tab-settings;
    in property <string> t-auto-title;
    in property <string> t-mode-time;
    in property <string> t-mode-sun;
    in property <string> t-light-from;
    in property <string> t-dark-from;
    in property <string> t-lat-ph;
    in property <string> t-lon-ph;
    in property <string> t-detect;
    in property <string> t-light-pm;
    in property <string> t-dark-pm;
    in property <string> t-apply-to;
    in property <string> t-apps;
    in property <string> t-system;
    in property <string> t-light-label;
    in property <string> t-dark-label;
    in property <string> t-light-wp-ph;
    in property <string> t-dark-wp-ph;
    in property <string> t-wp-hint;
    in property <string> t-accent-check;
    in property <string> t-accent-hint;
    in property <string> t-rescan;
    in property <string> t-autostart;
    in property <string> t-check-updates;
    in property <string> t-checking;
    in property <string> t-apply;
    in property <string> t-to-light;
    in property <string> t-to-dark;
    in property <string> t-light-now;
    in property <string> t-dark-now;
    in property <string> t-language;
    in property <string> t-releases;
    in property <string> t-onboard;
    in property <string> t-cancel;
    in property <string> t-close-title;
    in property <string> t-close-body;
    in property <string> t-close-minimize;
    in property <string> t-close-quit;
    in property <string> t-close-never;

    callback toggle-theme();
    callback settings-changed();
    callback apply-settings();
    callback language-changed();
    callback autostart-changed();
    callback detect-location();
    callback browse-light-wallpaper();
    callback browse-dark-wallpaper();
    callback check-updates();
    callback cancel-update();
    callback open-releases();
    callback clear-light-wallpaper();
    callback clear-dark-wallpaper();
    callback refresh-themes();
    callback close-minimize();
    callback close-quit();

    in-out property <int> tab-index: 0;

    VerticalBox {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    Image {
                        source: @image-url("../icon.svg");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;
                        horizontal-stretch: 1;
                        Text {
                            text: "WinThemeAuto";
                            font-size: 16px;
                            font-weight: 700;
                            color: #0f172a;
                        }
                        Text {
                            text: root.next-switch != "" ? (root.is-dark ? root.t-dark-now + " вЂў " : root.t-light-now + " вЂў ") + root.next-switch : (root.is-dark ? root.t-dark-now : root.t-light-now);
                            font-size: 12px;
