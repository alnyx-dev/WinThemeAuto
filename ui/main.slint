import { Switch, CheckBox, LineEdit, Button, ComboBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "WinThemeAuto";
    icon: @image-url("../icon.svg");
    background: #eef1f6;
    preferred-width: 460px;
    min-width: 360px;

    in property <bool> is-dark;
    in property <string> status;
    in property <string> sun-info;
    in property <string> next-switch;
    in property <string> geo-hint;
    in property <bool> locating;

    in-out property <bool> auto-enabled;
    in-out property <int> mode-index;
    in-out property <string> light-at;
    in-out property <string> dark-at;
    in-out property <string> lat;
    in-out property <string> lon;
    in-out property <string> light-offset;
    in-out property <string> dark-offset;
    in-out property <bool> change-apps;
    in-out property <bool> change-system;
    in-out property <bool> autostart;
    in-out property <bool> show-advanced;
    in property <string> app-version;
    in property <string> update-info;
    in property <bool> checking-update;
    in property <[string]> light-themes;
    in-out property <int> light-theme-index;
    in property <[string]> dark-themes;
    in-out property <int> dark-theme-index;
    in-out property <string> light-wallpaper;
    in-out property <string> dark-wallpaper;

    callback toggle-theme();
    callback settings-changed();
    callback detect-location();
    callback browse-light-wallpaper();
    callback browse-dark-wallpaper();
    callback check-updates();

    VerticalBox {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        // ── Header (compact, one row) ──
        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    Image {
                        source: @image-url("../icon.svg");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;
                        horizontal-stretch: 1;
                        Text {
                            text: "WinThemeAuto";
                            font-size: 16px;
                            font-weight: 700;
                            color: #0f172a;
                        }
                        Text {
                            text: root.next-switch != "" ? (root.is-dark ? "Dark now • " : "Light now • ") + root.next-switch : (root.is-dark ? "Dark now" : "Light now");
                            font-size: 12px;
                            color: #64748b;
                            overflow: elide;
                        }
                    }
                    Button {
                        text: root.is-dark ? "To light" : "To dark";
                        primary: true;
                        clicked => { root.toggle-theme(); }
                    }
                }
            }
        }

        // (Next switch lives in the header subtitle — fixed height, no jumps.)

        // ── Auto switch ──
        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: "Auto switch";
                        font-size: 13px;
                        font-weight: 700;
                        color: #0f172a;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked <=> root.auto-enabled;
                        toggled => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Button {
                        text: "By time";
                        primary: root.mode-index == 0;
                        horizontal-stretch: 1;
                        clicked => {
                            root.mode-index = 0;
                            root.settings-changed();
                        }
                    }
                    Button {
                        text: "Sunrise / sunset";
                        primary: root.mode-index == 1;
                        horizontal-stretch: 1;
                        clicked => {
                            root.mode-index = 1;
                            root.settings-changed();
                        }
                    }
                }

                if root.mode-index == 0 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Text {
                            text: "Light from";
                            font-size: 13px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.light-at;
                            placeholder-text: "07:00";
                            width: 90px;
                            accepted => { root.settings-changed(); }
                        }
                        Text {
                            text: "Dark from";
                            font-size: 13px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.dark-at;
                            placeholder-text: "19:00";
                            width: 90px;
                            accepted => { root.settings-changed(); }
                        }
                    }
                }

                if root.mode-index == 1 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        LineEdit {
                            text <=> root.lat;
                            placeholder-text: "Lat 55.75";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                        LineEdit {
                            text <=> root.lon;
                            placeholder-text: "Lon 37.61";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                        Button {
                            text: root.locating ? "…" : "Detect";
                            enabled: !root.locating;
                            clicked => { root.detect-location(); }
                        }
                    }
                    // Fixed heights: Detect only fills text, window never grows.
                    Text {
                        text: root.geo-hint;
                        height: 14px;
                        font-size: 11px;
                        color: #64748b;
                        overflow: elide;
                    }
                    Text {
                        text: root.sun-info;
                        height: 28px;
                        font-size: 11px;
                        color: #92400e;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Text {
                            text: "Light / dark offset (min)";
                            font-size: 12px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.light-offset;
                            placeholder-text: "0";
                            width: 55px;
                            accepted => { root.settings-changed(); }
                        }
                        LineEdit {
                            text <=> root.dark-offset;
                            placeholder-text: "0";
                            width: 55px;
                            accepted => { root.settings-changed(); }
                        }
                    }
                }
            }
        }

        // ── Targets + themes (one card) ──
        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: "Apply to:";
                        font-size: 13px;
                        font-weight: 600;
                        color: #0f172a;
                        vertical-alignment: center;
                    }
                    CheckBox {
                        text: "Apps";
                        checked <=> root.change-apps;
                        toggled => { root.settings-changed(); }
                    }
                    CheckBox {
                        text: "System";
                        checked <=> root.change-system;
                        toggled => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Light:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.light-themes;
                        current-index <=> root.light-theme-index;
                        horizontal-stretch: 1;
                        selected => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Dark:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.dark-themes;
                        current-index <=> root.dark-theme-index;
                        horizontal-stretch: 1;
                        selected => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.light-wallpaper;
                        placeholder-text: "Light wallpaper (optional)…";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    Button {
                        text: "…";
                        clicked => { root.browse-light-wallpaper(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.dark-wallpaper;
                        placeholder-text: "Dark wallpaper (optional)…";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    Button {
                        text: "…";
                        clicked => { root.browse-dark-wallpaper(); }
                    }
                }
                Text {
                    text: "A custom path wins over the theme wallpaper. Empty = theme only.";
                    font-size: 11px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }
            }
        }

        // ── Footer ──
        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    CheckBox {
                        text: "Start with Windows";
                        horizontal-stretch: 1;
                        checked <=> root.autostart;
                        toggled => { root.settings-changed(); }
                    }
                    Button {
                        text: "Apply";
                        primary: true;
                        clicked => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: "v" + root.app-version;
                        font-size: 11px;
                        color: #94a3b8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.checking-update ? "Checking…" : "Check for updates";
                        enabled: !root.checking-update;
                        clicked => { root.check-updates(); }
                    }
                }
                // One fixed line: error (red) wins, else update info. Never grows.
                Text {
                    text: root.status != "" ? root.status : root.update-info;
                    height: 14px;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.status != "" ? #b91c1c : #64748b;
                    overflow: elide;
                }
            }
        }
    }
}
