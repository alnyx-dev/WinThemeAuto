            }
            Button {
                text: root.t-tab-appearance;
                primary: root.tab-index == 1;
                horizontal-stretch: 1;
                clicked => { root.tab-index = 1; }
            }
            Button {
                text: root.t-tab-settings;
                primary: root.tab-index == 2;
                horizontal-stretch: 1;
                clicked => { root.tab-index = 2; }
            }
        }

        Rectangle {
            height: 400px;
            VerticalBox {
                padding: 0px;
                spacing: 0px;
                alignment: start;
        if root.tab-index == 0 : Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: root.t-auto-title;
                        font-size: 13px;
                        font-weight: 700;
                        color: #0f172a;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked <=> root.auto-enabled;
                        toggled => { root.settings-changed(); }
                    }
