                    LineEdit {
                        text <=> root.light-wallpaper;
                        placeholder-text: root.t-light-wp-ph;
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); } edited(_t) => { root.settings-changed(); }
                    }
                    Button {
                        text: "вЂ¦";
                        clicked => { root.browse-light-wallpaper(); }
                    }
                    Button {
                        text: "Г—";
                        clicked => { root.clear-light-wallpaper(); }
                    }
                }
                HorizontalBox {
