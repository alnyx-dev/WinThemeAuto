import { Switch, CheckBox, LineEdit, Button, ComboBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

component AccentSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <string> hex;
    in property <bool> active;
    callback chosen(string);

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: swatch-color;
    border-width: active ? 2px : 1px;
    border-color: active ? #0f172a : #00000033;

    TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.chosen(root.hex); }
    }
}

export component MainWindow inherits Window {
    title: "WinThemeAuto";
    icon: @image-url("../icon.svg");
    background: #eef1f6;
    preferred-width: 460px;
    min-width: 360px;

    in property <bool> is-dark;
    in property <string> status;
    in property <string> sun-info;
    in property <string> next-switch;
    in property <string> geo-hint;
    in property <bool> locating;

    in-out property <bool> auto-enabled;
    in-out property <int> mode-index;
    in-out property <string> light-at;
    in-out property <string> dark-at;
    in-out property <string> lat;
    in-out property <string> lon;
    in-out property <string> light-offset;
    in-out property <string> dark-offset;
    in-out property <bool> change-apps;
    in-out property <bool> change-system;
    in-out property <bool> autostart;
    in-out property <bool> show-advanced;
    in property <string> app-version;
    in property <string> update-info;
    in property <bool> update-ok;
    in property <bool> checking-update;
    in property <[string]> light-themes;
    in-out property <int> light-theme-index;
    in property <[string]> dark-themes;
    in-out property <int> dark-theme-index;
    in-out property <string> light-wallpaper;
    in-out property <string> dark-wallpaper;
    in-out property <bool> accent-enabled;
    in-out property <string> light-accent;
    in-out property <string> dark-accent;

    callback toggle-theme();
    callback settings-changed();
    callback detect-location();
    callback browse-light-wallpaper();
    callback browse-dark-wallpaper();
    callback check-updates();

    // Pure UI navigation, no Rust involvement.
    property <int> tab-index: 0;

    VerticalBox {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        // ── Header (compact, one row) ──
        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    Image {
                        source: @image-url("../icon.svg");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;
                        horizontal-stretch: 1;
                        Text {
                            text: "WinThemeAuto";
                            font-size: 16px;
                            font-weight: 700;
                            color: #0f172a;
                        }
                        Text {
                            text: root.next-switch != "" ? (root.is-dark ? "Dark now • " : "Light now • ") + root.next-switch : (root.is-dark ? "Dark now" : "Light now");
                            font-size: 12px;
                            color: #64748b;
                            overflow: elide;
                        }
                    }
                    Button {
                        text: root.is-dark ? "To light" : "To dark";
                        primary: true;
                        clicked => { root.toggle-theme(); }
                    }
                }
            }
        }

        // (Next switch lives in the header subtitle — fixed height, no jumps.)

        // ── Tab bar (always visible) ──
        HorizontalBox {
            padding: 0px;
            spacing: 6px;
            Button {
                text: "Auto switch";
                primary: root.tab-index == 0;
                horizontal-stretch: 1;
                clicked => { root.tab-index = 0; }
            }
            Button {
                text: "Appearance";
                primary: root.tab-index == 1;
                horizontal-stretch: 1;
                clicked => { root.tab-index = 1; }
            }
            Button {
                text: "Settings";
                primary: root.tab-index == 2;
                horizontal-stretch: 1;
                clicked => { root.tab-index = 2; }
            }
        }

        // ── Auto switch ──
        if root.tab-index == 0 : Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: "Auto switch";
                        font-size: 13px;
                        font-weight: 700;
                        color: #0f172a;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked <=> root.auto-enabled;
                        toggled => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Button {
                        text: "By time";
                        primary: root.mode-index == 0;
                        horizontal-stretch: 1;
                        clicked => {
                            root.mode-index = 0;
                            root.settings-changed();
                        }
                    }
                    Button {
                        text: "Sunrise / sunset";
                        primary: root.mode-index == 1;
                        horizontal-stretch: 1;
                        clicked => {
                            root.mode-index = 1;
                            root.settings-changed();
                        }
                    }
                }

                if root.mode-index == 0 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Text {
                            text: "Light from";
                            font-size: 13px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.light-at;
                            placeholder-text: "07:00";
                            width: 90px;
                            accepted => { root.settings-changed(); }
                        }
                        Text {
                            text: "Dark from";
                            font-size: 13px;
                            color: #334155;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.dark-at;
                            placeholder-text: "19:00";
                            width: 90px;
                            accepted => { root.settings-changed(); }
                        }
                    }
                }

                if root.mode-index == 1 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        LineEdit {
                            text <=> root.lat;
                            placeholder-text: "Lat 55.75";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                        LineEdit {
                            text <=> root.lon;
                            placeholder-text: "Lon 37.61";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                        Button {
                            text: root.locating ? "…" : "Detect";
                            enabled: !root.locating;
                            clicked => { root.detect-location(); }
                        }
                    }
                    // Fixed heights: Detect only fills text, window never grows.
                    Text {
                        text: root.geo-hint;
                        height: 14px;
                        font-size: 11px;
                        color: #64748b;
                        overflow: elide;
                    }
                    Text {
                        text: root.sun-info;
                        height: 14px;
                        font-size: 11px;
                        color: #92400e;
                        overflow: elide;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text {
                            text: "Light ±";
                            font-size: 12px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.light-offset;
                            placeholder-text: "0";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                        Text {
                            text: "Dark ±";
                            font-size: 12px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.dark-offset;
                            placeholder-text: "0";
                            horizontal-stretch: 1;
                            accepted => { root.settings-changed(); }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: #f1f5f9;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: "Apply to:";
                        font-size: 12px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                    CheckBox {
                        text: "Apps";
                        checked <=> root.change-apps;
                        toggled => { root.settings-changed(); }
                    }
                    CheckBox {
                        text: "System";
                        checked <=> root.change-system;
                        toggled => { root.settings-changed(); }
                    }
                }
            }
        }

        // ── Appearance: themes, wallpapers, accent (one card) ──
        if root.tab-index == 1 : Rectangle {
            background: white;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Light:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.light-themes;
                        current-index <=> root.light-theme-index;
                        horizontal-stretch: 1;
                        selected => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Dark:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.dark-themes;
                        current-index <=> root.dark-theme-index;
                        horizontal-stretch: 1;
                        selected => { root.settings-changed(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.light-wallpaper;
                        placeholder-text: "Light wallpaper (optional)…";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    Button {
                        text: "…";
                        clicked => { root.browse-light-wallpaper(); }
                    }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.dark-wallpaper;
                        placeholder-text: "Dark wallpaper (optional)…";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    Button {
                        text: "…";
                        clicked => { root.browse-dark-wallpaper(); }
                    }
                }
                Text {
                    text: "A custom path wins over the theme wallpaper. Empty = theme only.";
                    font-size: 11px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 1px;
                    background: #f1f5f9;
                }
                CheckBox {
                    text: "Sync accent color with theme";
                    checked <=> root.accent-enabled;
                    toggled => { root.settings-changed(); }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Light:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.light-accent;
                        placeholder-text: "0078D4";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    AccentSwatch { swatch-color: #FFB900; hex: "FFB900"; active: root.light-accent == "FFB900"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #E81123; hex: "E81123"; active: root.light-accent == "E81123"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #EC008C; hex: "EC008C"; active: root.light-accent == "EC008C"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #B4009E; hex: "B4009E"; active: root.light-accent == "B4009E"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #744DA9; hex: "744DA9"; active: root.light-accent == "744DA9"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #0078D4; hex: "0078D4"; active: root.light-accent == "0078D4"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #00B7C3; hex: "00B7C3"; active: root.light-accent == "00B7C3"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #107C10; hex: "107C10"; active: root.light-accent == "107C10"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: "Dark:";
                        font-size: 12px;
                        color: #64748b;
                        width: 38px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.dark-accent;
                        placeholder-text: "0078D4";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); }
                    }
                    AccentSwatch { swatch-color: #FFB900; hex: "FFB900"; active: root.dark-accent == "FFB900"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #E81123; hex: "E81123"; active: root.dark-accent == "E81123"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #EC008C; hex: "EC008C"; active: root.dark-accent == "EC008C"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #B4009E; hex: "B4009E"; active: root.dark-accent == "B4009E"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #744DA9; hex: "744DA9"; active: root.dark-accent == "744DA9"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #0078D4; hex: "0078D4"; active: root.dark-accent == "0078D4"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #00B7C3; hex: "00B7C3"; active: root.dark-accent == "00B7C3"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #107C10; hex: "107C10"; active: root.dark-accent == "107C10"; chosen(h) => { root.dark-accent = h; root.settings-changed(); } }
                }
                Text {
                    text: "Click a swatch to apply instantly — taskbar needs “Show accent color” on.";
                    font-size: 10px;
                    color: #94a3b8;
                    overflow: elide;
                }
            }
        }

        // ── Settings ──
        if root.tab-index == 2 : VerticalBox {
            padding: 0px;
            spacing: 8px;
            Rectangle {
                background: white;
                border-width: 1px;
                border-color: #e2e8f0;
                border-radius: 10px;
                VerticalBox {
                    padding: 10px;
                    spacing: 8px;
                    CheckBox {
                        text: "Start with Windows";
                        checked <=> root.autostart;
                        toggled => { root.settings-changed(); }
                    }
                }
            }
            Rectangle {
                background: white;
                border-width: 1px;
                border-color: #e2e8f0;
                border-radius: 10px;
                VerticalBox {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Button {
                            text: root.checking-update ? "Checking…" : "Check for updates";
                            enabled: !root.checking-update;
                            clicked => { root.check-updates(); }
                        }
                        Text {
                            text: root.update-info != "" ? root.update-info : "v" + root.app-version;
                            font-size: 11px;
                            color: root.update-ok ? #15803d : #94a3b8;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ── Slim footer: errors only + Apply, always visible ──
        Text {
            text: root.status;
            height: 14px;
            font-size: 11px;
            font-weight: 600;
            color: #b91c1c;
            overflow: elide;
        }
        Button {
            text: "Apply";
            primary: true;
            horizontal-stretch: 1;
            clicked => { root.settings-changed(); }
        }
    }
}
