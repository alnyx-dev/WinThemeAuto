                            root.settings-changed();
                        }
                    }
                    Button {
                        text: root.t-mode-sun;
                        primary: root.mode-index == 1;
                        horizontal-stretch: 1;
                        clicked => {
                            root.mode-index = 1;
                            root.settings-changed();
                        }
                    }
                }

                if root.mode-index == 0 : VerticalBox {
                    padding: 0px;
                    spacing: 6px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
