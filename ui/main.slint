                    }
                    Button {
                        text: "Г—";
                        clicked => { root.clear-dark-wallpaper(); }
                    }
                }
                Text {
                    text: root.t-wp-hint;
                    font-size: 11px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 1px;
                    background: #f1f5f9;
                }
                CheckBox {
                    text: root.t-accent-check;
                    checked <=> root.accent-enabled;
                    toggled => { root.settings-changed(); }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text {
                        text: root.t-light-label;
                        font-size: 12px;
                        color: #64748b;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.light-accent;
                        placeholder-text: "0078D4";
                        horizontal-stretch: 1;
                        accepted => { root.settings-changed(); } edited(_t) => { root.settings-changed(); }
                    }
                    AccentSwatch { swatch-color: #FFB900; hex: "FFB900"; active: root.light-accent == "FFB900"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #E81123; hex: "E81123"; active: root.light-accent == "E81123"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #EC008C; hex: "EC008C"; active: root.light-accent == "EC008C"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #B4009E; hex: "B4009E"; active: root.light-accent == "B4009E"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #744DA9; hex: "744DA9"; active: root.light-accent == "744DA9"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #0078D4; hex: "0078D4"; active: root.light-accent == "0078D4"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #00B7C3; hex: "00B7C3"; active: root.light-accent == "00B7C3"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
                    AccentSwatch { swatch-color: #107C10; hex: "107C10"; active: root.light-accent == "107C10"; chosen(h) => { root.light-accent = h; root.settings-changed(); } }
